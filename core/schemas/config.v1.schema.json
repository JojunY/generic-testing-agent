{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gta:schema:config:v1",
  "title": "gta configuration (.gta/config.json)",
  "description": "Optional overrides of gta defaults. Only the keys you set are used.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "enum": [
            "auto",
            "maven",
            "gradle"
          ],
          "description": "\"auto\" = gradle when the service has build.gradle(.kts) and no pom.xml, else maven"
        },
        "gradle": {
          "type": "string",
          "description": "\"auto\" = gradlew if present, else gradle"
        },
        "module": {
          "type": "string",
          "description": "the module (or Gradle subproject) that holds the service in a multi-module repository"
        },
        "javaHomeEnv": {
          "type": "string",
          "description": "name of an environment variable holding the JDK the service builds with"
        },
        "basePackage": {
          "type": "string",
          "description": "\"auto\" = package of the @SpringBootApplication class"
        },
        "maven": {
          "type": "string",
          "description": "\"auto\" = mvnw if present, else mvn"
        }
      }
    },
    "dispatch": {
      "enum": [
        "subagent",
        "inline"
      ],
      "description": "how the orchestrator runs analyze/author/review nodes; inline when the IDE cannot run subagents"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "gta",
            "openspec",
            "speckit"
          ]
        },
        "maxQuestionsPerRound": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "maxClarifyRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "maxSubmitAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "rejected spec submissions in a row before the flow escalates to a human"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "enum": ["en", "zh-CN"],
          "description": "Language of what gta shows people: questions, prompts and the status block"
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "testUrl": {
              "type": "string",
              "pattern": "^jdbc:oracle:"
            },
            "userEnv": {
              "type": "string"
            },
            "passwordEnv": {
              "type": "string"
            }
          }
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolsUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lower values are allowed; values below the floors are raised to them.",
      "properties": {
        "maxChecksPerItem": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttemptsPerItem": {
          "type": "integer",
          "minimum": 1
        },
        "maxConsecutiveFailures": {
          "type": "integer",
          "minimum": 1
        },
        "maxItemsPerSession": {
          "type": "integer",
          "minimum": 1
        },
        "nodeTimeoutMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "sessionIdleMinutes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "qualityGates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stabilityRepeat": {
          "type": "integer",
          "minimum": 1
        },
        "stabilityTimezone": {
          "type": "string",
          "description": "Timezone of the stability variant run (default Asia/Kolkata)"
        },
        "stabilityLocale": {
          "type": "string",
          "description": "BCP 47 locale of the stability variant run (default de-DE)"
        },
        "oracleReview": {
          "const": true,
          "description": "organisation floor: the independent oracle review cannot be switched off"
        },
        "concernsCharacterizationRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "advisory",
                "enforced"
              ]
            },
            "minStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]$",
      "description": "Opt into a later roadmap phase early, e.g. P5"
    }
  }
}
