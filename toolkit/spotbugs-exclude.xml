<?xml version="1.0" encoding="UTF-8"?>
<!--
  Documented SpotBugs exceptions only (docs/reviews/round-3-plan.md §3.2, Q-R8). Every other finding is fixed.
-->
<FindBugsFilter>
  <!-- Persisted DTOs (state, plan, config, shards, waivers, profiles, registry) expose public mutable fields so Jackson
       can map them. SpotBugs cannot see Jackson setting a field, nor a field read in another module (gta-cli reads config
       fields) or by humans (a waiver's "by" and "reason"); copying them defensively would change nothing for a
       single-threaded CLI. Typed accessors are deferred with Q-R9. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD,UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD,UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD,NP_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD,PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
  </Match>
</FindBugsFilter>
