#!/bin/sh
# gtaw — gta wrapper (like mvnw). Downloads the pinned gta-cli jar from the company Nexus, verifies its sha256
# before every run, then runs it. Managed by gta: do not edit (./gtaw upgrade rewrites it).
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROPS="$DIR/.gta/wrapper/gta-wrapper.properties"

prop() { sed -n "s/^$1=//p" "$PROPS" 2>/dev/null | tail -n 1; }

if [ -n "$GTA_CLI_JAR" ]; then
  JAR="$GTA_CLI_JAR"
else
  VERSION=$(prop version)
  URL=$(prop distributionUrl)
  SHA=$(prop distributionSha256Sum)
  [ -n "$VERSION" ] || { echo '{"error":{"code":"CONFIG_NOT_INITIALIZED","category":"config","message":"missing .gta/wrapper/gta-wrapper.properties","hint":"run gta-cli init --platform copilot|opencode","retryable":false}}'; exit 21; }
  # fail closed: never download or run a jar whose checksum is not pinned
  if [ -z "$SHA" ] || [ -z "$URL" ]; then
    echo '{"error":{"code":"CONFIG_NOT_INITIALIZED","category":"config","message":"distributionUrl and distributionSha256Sum must be set in .gta/wrapper/gta-wrapper.properties","hint":"set both to the Nexus gta-cli jar and its sha256 (or GTA_CLI_JAR to a local jar for development)","retryable":false}}'
    exit 21
  fi
  CACHE="${GTA_HOME:-$HOME/.gta}/wrapper/dists"
  JAR="$CACHE/gta-cli-$VERSION.jar"
  if [ ! -f "$JAR" ]; then
    mkdir -p "$CACHE"
    TMP=$(mktemp "$CACHE/gta-cli-$VERSION.XXXXXX") # one file per process: parallel first runs do not collide
    # credentials never appear on a command line (visible in ps): curl reads them from stdin, wget from the environment
    if command -v curl >/dev/null 2>&1; then
      if [ -n "$GTA_NEXUS_USER" ]; then
        printf 'user = "%s:%s"\n' "$GTA_NEXUS_USER" "$GTA_NEXUS_PASSWORD" | curl -fsSL -K - -o "$TMP" "$URL" && OK=1 || OK=0
      else
        curl -fsSL -o "$TMP" "$URL" && OK=1 || OK=0
      fi
    elif [ -n "$GTA_NEXUS_USER" ]; then
      WGETRC=$(mktemp); printf 'user=%s\npassword=%s\n' "$GTA_NEXUS_USER" "$GTA_NEXUS_PASSWORD" > "$WGETRC"
      WGETRC="$WGETRC" wget -q -O "$TMP" "$URL" && OK=1 || OK=0; rm -f "$WGETRC"
    else
      wget -q -O "$TMP" "$URL" && OK=1 || OK=0
    fi
    if [ "$OK" != 1 ]; then
      rm -f "$TMP"
      echo '{"error":{"code":"ENV_TOOL_UNAVAILABLE","category":"environment","message":"cannot download the gta-cli jar from distributionUrl","hint":"check distributionUrl in .gta/wrapper/gta-wrapper.properties, the network and GTA_NEXUS_USER/GTA_NEXUS_PASSWORD","retryable":true}}'
      exit 30
    fi
    mv "$TMP" "$JAR"
  fi
  if command -v sha256sum >/dev/null 2>&1; then ACTUAL=$(sha256sum "$JAR" | cut -d' ' -f1); else ACTUAL=$(shasum -a 256 "$JAR" | cut -d' ' -f1); fi
  if [ "$ACTUAL" != "$SHA" ]; then
    rm -f "$JAR"
    echo '{"error":{"code":"ENV_WRAPPER_CHECKSUM_MISMATCH","category":"environment","message":"gta-cli jar checksum mismatch","hint":"check distributionUrl/distributionSha256Sum in .gta/wrapper/gta-wrapper.properties","retryable":false}}'
    exit 30
  fi
fi
# The JVM decodes arguments with the locale; make sure non-ASCII replies (e.g. Chinese) arrive intact.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *UTF-8*|*utf-8*|*UTF8*|*utf8*) ;;
  *) if [ "$(uname -s)" = Darwin ]; then export LC_CTYPE=UTF-8; else export LC_ALL=C.UTF-8; fi ;;
esac
exec java ${GTA_JAVA_OPTS} -jar "$JAR" --root "$DIR" "$@"
